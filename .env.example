# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anthropic API Key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_PATH=data/splitbot.db

# Currency API
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/{base}

# Defaults
DEFAULT_CURRENCY=EUR
DEFAULT_SPLIT_RATIO_1=0.5
DEFAULT_SPLIT_RATIO_2=0.5

# Supported currencies (comma-separated)
SUPPORTED_CURRENCIES=USD,EUR,GBP,JPY,INR,CAD,AUD,CHF,CNY,SEK,NZD,KRW,SGD,HKD,NOK,DKK,MXN,ZAR

# Receipt processing
RECEIPT_CONFIRMATION_TIMEOUT=600  # 10 minutes in seconds

# Limits
MAX_EXPENSE_AMOUNT=1000000
MAX_HISTORY_ITEMS=50
MAX_CHAT_MEMBERS=20  # Maximum number of people in a chat (excluding bot)

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/splitbot.log
